    subgraph ON["Algorand local state"]
        LS["RefugeeContract<br/>per-wallet local state"]
    end

    PII -->|"hash + salt"| HID
    PII -->|"liveness composite"| HP
    PII -->|"over18 flag"| HA
    HID --> LS
    HP --> LS
    HA --> LS

    Note1["No raw PII stored on-chain"]
